<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\</RepositoryRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <ArtifactsDirectory>$(RepositoryRoot)artifacts\bin\$(Configuration)\</ArtifactsDirectory>
  </PropertyGroup>
  <Target Name="Build">
    <MSBuild Projects="$(RepositoryRoot)NeoTransmission.slnx" Targets="Rebuild"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <ApplicationFiles Include="$(RepositoryRoot)src\NeoTransmission\bin\$(Configuration)\**\*" />
      <VersionToolFiles Include="$(RepositoryRoot)utils\GetVersion\bin\$(Configuration)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ApplicationFiles)"
          DestinationFiles="@(ApplicationFiles->'$(ArtifactsDirectory)NeoTransmission\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(VersionToolFiles)"
          DestinationFiles="@(VersionToolFiles->'$(ArtifactsDirectory)GetVersion\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Build output: $(ArtifactsDirectory)" Importance="high" />
  </Target>
</Project>
